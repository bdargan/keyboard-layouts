(defalias
  mse (layer-while-held mouse-layer)
)

(defalias
  ;; mouse or escape
  moe (tap-hold $tap-time $hold-time esc @mse)
)

(defalias
  fst (movemouse-speed 200)
  slw (movemouse-speed 50)
  vsl (movemouse-speed 25)

  mwu (mwheel-up 50 60)
  mwd (mwheel-down 50 60)
  mwl (mwheel-left 50 60)
  mwr (mwheel-right 50 60)

  ms↑ (movemouse-up 4 5)
  ms← (movemouse-left 4 5)
  ms↓ (movemouse-down 4 5)
  ms→ (movemouse-right 4 5)

;; ma on mac, >= 15. for 60mHz screens
  ma↑ (movemouse-accel-up    16 200 2 40)
  ma← (movemouse-accel-left  16 200 2 40)
  ma↓ (movemouse-accel-down  16 200 2 40)
  ma→ (movemouse-accel-right 16 200 2 40)

)


 
(defalias
  ;; Layout Profile Changers (Linked to numbers 1, 2, 3 inside the profile-control layer)
  to-col (layer-switch colemak-dh)
  to-str (layer-switch magic-sturdy)
  to-qwe (layer-switch qwerty)

  ;; Tapping outputs ` (backtick). Holding opens the Profile Control Layer.
  grv-ldr (tap-hold-release $tap-time $hold-time grv (layer-while-held profile-control))

  ;; Standard Layer Toggles
  ;; todo spc for syms no good for vim, conflict with my ldr 
  spc-mo (tap-hold-press $tap-time $hold-time spc (layer-while-held num-r1))

  esc-ctl (tap-hold-press $tap-time-s $hold-time esc lctl)
  ;; ec_dtm  (tap-dance $tap-time (@esc-ctl @mse))

  rpt-sym (tap-hold $tap-time $hold-time rpt (layer-while-held sym-r3)) 
 
 ;; avoid this
  ;; num-sym activate with rctl tap
  num-sym-r1 (tap-hold-release $tap-timeout $hold-time (one-shot-release-pcancel $one-shot-timeout (layer-while-held num-sym-r1)) rctl)

  ;; sym-num activates when holding lctl, lctl fires when tapped
  sym-num-r1 (tap-hold-release $tap-timeout $hold-time (one-shot-release-pcancel $one-shot-timeout (layer-while-held sym-num-r1)) lctl) 


  ;; 2. Left Thumb Magic Key on LMet (Fires magic on tap, acts as LMet on hold)
  ;; Add your specific Afterburner fallback 'rpt' macro logic inside your macro rules
  mgc-met (tap-hold $tap-time $hold-time @mgc lmet)

  ;; 3. Right Thumb Repeat Key on RMet (Fires repeat on tap, acts as RMet on hold)
  rpt-met (tap-hold $tap-time $hold-time rpt rmet)


)

;; ==========================================
;; BASE LAYER 1: default layer Pure QWERTY (for Pass-Through Bluetooth Profile)
;; Pass-Through allows fallback for troubleshooting, split keyboards with own mapping and deflayermap for consistent base
;; ==========================================
(deflayer qwerty
  esc      f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @grv-ldr 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab      q    w    e    r    t    y    u    i    o    p    [    ]    \
  @esc-ctl a s d f g    h    j k l ; '    ret
  lsft     z    x    c    v    b    n    m    ,    .    /    rsft
  fn       lctl lalt lmet          @spc-mo        rmet ralt rctl
)

;; ==========================================
;; BASE LAYER 2: Colemak-DH (Default Alpha Profile)
;; ==========================================
(deflayer colemak-dh
  esc      f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  @grv-ldr 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab      q    w    f    p    b    j    l    u    y    ;    [    ]    \
  @esc-ctl   a   r    s t  g    m    n    e    i o '    
  ret lsft       x    c    d    v    z    k    h    ,    .    /    rsft
  @mse @sym-num-r1 lalt lmet                @spc-mo         @rpt-sym ralt @sym-num-r1
)

;;  
;; ==========================================
;; Original magic-sturdy from icelaks - 
;; ==========================================
;;V M L C P "        | B ^ U O , \
;;S T R D Y Q        $ F N E A I -
;;X K J G W            Z H ' ? .
;;        ⎵ ⇥     / @ ⇧
;;^ is the magic key, and @ is the repeat key.

;; ==========================================
;;2. Stagger-Neutral Alpha Translation
;; ==========================================
;;The alphanumeric blocks have been shifted horizontally by one unit on the top and bottom rows. 
;;This shift counteracts the physical slant of standard laptop keys, keeping the columns straight relative to your natural typing angles:
;;V  M  L  C  P        B  U  O  ,  .
;;S  T  R  D  Y        F  N  E  A  I  '
;;X  K  J  G  W        Z  H  /  ?  \
;; ==========================================
;; BASE LAYER 3: Magic Sturdy (Learning Profile)
;; ==========================================
(deflayer magic-sturdy
  esc          f1   f2             f3        f4   f5   f6   f7   f8   f9   f10  f11  f12
  @grv-ldr      1    2              3         4    5    6    7    8    9    0     -    @eq-main    bspc
  tab           v    m              l         c    p    b    u    o    ,    .     [    ]    \
  @esc-ctl s    t    r    d    y    f    n    e    a    i     '  ret
  lsft          x         k         j         g    w    z    h    /    S-/  q  rsft
  fn       lctl lalt @mgc-met          @spc-mo @rpt-met ralt rctl
)

;; ==========================================
;; CONTROL LAYER: The Layout Dashboard (Hold Grave to access)
;; ==========================================
(deflayer profile-control
  _         _       _       _   _    _    _    _    _    _    _    _    _
  _   @to-qwe @to-col @to-str   _    _    _    _    _    _    _    _    _    _
  lrld    _       _       _        _    _    _    _    _    _    _    _    _    _
  lrld    _       lrld _        _    _    _    _    _    _    _    _    _
  _       _       _       _       _    _    _    _    _    _    _    _ 
  _       _       _       _            _              _    _  _
)
