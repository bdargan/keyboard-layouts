(deflayer navigation
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    1    2    3    4    5    6    7    8    9    0    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  _    _    _    _    _    _    _    _    _    _    _    
  _    _    _    _             _               _    _ _
)
;; z mute
;; x vold
;; c volu

(deflayermap (mouse-layer)
 ;; --- Left Hand: Precision Modifiers ---
a @fst   ;; Hold to make linear keys go fast (200%)
s @slw   ;; Hold for standard Sniper mode (50%)
d @vsl   ;; Hold for ultra-precise Video/Design work (25%)

;; --- Right Hand: Macro Acceleration (Fixed curves, unaffected by modifiers) ---
y @ma←
u @ma↓
i @ma↑
o @ma→

;; --- Right Hand: Linear Micro Movements (Affected by a, s, d modifiers) ---
h @ms← 
j @ms↓ 
k @ms↑
l @ms→ 

;; --- Right Hand: Scrolling ---
n @mwl
m @mwd
, @mwu
. @mwr

;; --- Left Hand: Standard Mouse Buttons ---
e mlft       ;; Middle finger = Left Click
r mrgt       ;; Index finger = Right Click
;; Ring finger = Middle Click

caps  @switch-layer-mouse 
;;___ (multi _ @exit-to-colemak)
)

